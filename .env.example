ENV=production

TZ=Europe/Paris
UMASK_SET=0002

# Set to the user/group that should own media files created by containers.
# Run `id $(whoami)` on your host to find appropriate values.
PUID=1000
PGID=1000

POSTGRES_DB=bobarr
POSTGRES_USER=bobarr
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

JACKETT_AUTOMATIC_SEARCH_TIMEOUT=120000
JACKETT_MANUAL_SEARCH_TIMEOUT=15000

LIBRARY_MOVIES_FOLDER_NAME=movies
LIBRARY_TV_SHOWS_FOLDER_NAME=tvshows

DEBUG_REDIS=false

# Optional: override the browser-facing API URL when serving Bobarr behind a
# reverse proxy.
# WEB_UI_API_URL=https://bobarr.example.com/api
